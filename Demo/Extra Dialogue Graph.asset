  - id: 6e53f1c097274f91b5b040c4d9068264
    sprite: {fileID: 21300000, guid: a852d2b82156e814fb87401d161bacb1, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 0
    type: 0
    context:
      translations:
      - "Hey, is that... a paper airplane?"
      - "\u5450 \u90A3\u662F...\u7D19\u98DB\u6A5F?"
  - id: 51f7e9b47a044646bc9e8ebada9fa7eb
    sprite: {fileID: 21300000, guid: 9e2c9d5b74f63464b9a6297a9b138259, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 1
    type: 0
    context:
      translations:
      - "Yeah."
      - "\u55EF"
  - id: bab7ca556fc64e05bbfecd3da90d5023
    sprite: {fileID: 21300000, guid: a852d2b82156e814fb87401d161bacb1, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 0
    type: 0
    context:
      translations:
      - "The ones you just threw?"
      - "\u525B\u624D\u653E\u7684\u90A3\u4E9B?"
  - id: 56b06fa7c85f4d8f843887234353fd4b
    sprite: {fileID: 21300000, guid: 9e2c9d5b74f63464b9a6297a9b138259, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 1
    type: 0
    context:
      translations:
      - "Yeah."
      - "\u55EF"
  - id: cff70f8f0b2944edaf9b05e0171ff279
    sprite: {fileID: 21300000, guid: 9e2c9d5b74f63464b9a6297a9b138259, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 1
    type: 0
    context:
      translations:
      - "I was actually going to throw them away."
      - "\u6211\u672C\u4F86\u662F\u60F3\u6254\u6389\u4ED6\u5011\u7684"
  - id: 2a7c89daa4404e568bd01e570e3828a5
    sprite: {fileID: 21300000, guid: 9e2c9d5b74f63464b9a6297a9b138259, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 1
    type: 0
    context:
      translations:
      - "But I couldn't bring myself to tear them up."
      - "\u4F46\u662F\u6211\u6C92\u6709\u52C7\u6C23\u53BB\u6495\u788E\u5B83\u5011"
  - id: 109f3809aab643718fd368df08d0b418
    sprite: {fileID: 21300000, guid: 9e2c9d5b74f63464b9a6297a9b138259, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 1
    type: 2
    context:
      translations:
      - "So I just folded them up, and they ended up like this."
      - "\u6240\u4EE5\u5C31\u96A8\u4FBF\u6298\u4E86 \u7136\u5F8C\u8B8A\u6210\u4E86\u9019\u6A23"
