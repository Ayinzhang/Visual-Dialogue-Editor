  - id: 36bfc0b22f9d4ef7b96bd950fc5b3e97
    sprite: {fileID: 21300000, guid: 9e2c9d5b74f63464b9a6297a9b138259, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 1
    type: 1
    context:
      translations:
      - "Huh? What do you want it for?"
