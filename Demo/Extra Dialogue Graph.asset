  - id: 07e492603ff84dde9779969a3fe8ada8
    sprite: {fileID: 21300000, guid: 9e2c9d5b74f63464b9a6297a9b138259, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 1
    type: 0
    context:
      translations:
      - "You're so strange..."
      - "\u771F\u5947\u602A\u2014"
  - id: 9875a17cf7a947c991cf3f9dc32d6d71
    sprite: {fileID: 21300000, guid: 9e2c9d5b74f63464b9a6297a9b138259, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 1
    type: 0
    context:
      translations:
      - "But no. I was going to throw it away."
      - "\u4F46\u662F\u4E0D\u884C \u9019\u662F\u8981\u6254\u7684"
  - id: cb0bcd24feb1433cb752fdb099be6137
    sprite: {fileID: 21300000, guid: a852d2b82156e814fb87401d161bacb1, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 0
    type: 0
    context:
      translations:
      - "Huh?"
      - "\u8A92"
  - id: 311e49705c1641b3a9878813bbca3032
    sprite: {fileID: 21300000, guid: 9e2c9d5b74f63464b9a6297a9b138259, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 1
    type: 0
    context:
      translations:
      - "...Still, I'm glad you said you wanted it."
      - "...\u4E0D\u904E\u4F60\u8AAC\u60F3\u8981\u6211\u5F88\u9AD8\u8208"
  - id: 3472cddb14f44e45ae65a31363830efd
    sprite: {fileID: 21300000, guid: a852d2b82156e814fb87401d161bacb1, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 0
    type: 0
    context:
      translations:
      - "Will you keep drawing in the future?"
      - "\u5C07\u4F86\u6703\u7E7C\u7E8C\u756B\u756B\u4E4B\u985E\u55CE?"
  - id: 211d265e812c46cea199a461b07cdded
    sprite: {fileID: 21300000, guid: 9e2c9d5b74f63464b9a6297a9b138259, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 1
    type: 0
    context:
      translations:
      - "...Mm... I'd like to, but I don't think I can."
      - "...\u5514\u2014\u96D6\u7136\u60F3\u4F46\u662F\u6C92\u53EF\u80FD\u5427"
  - id: 581f0842a18a4045914ceb4f48a29bb1
    sprite: {fileID: 21300000, guid: a852d2b82156e814fb87401d161bacb1, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 0
    type: 0
    context:
      translations:
      - "Wh-why?! You're so good at it!"
      - "\u70BA \u7232\u4EC0\u9EBD\u2014\uFF01\u660E\u660E\u756B\u7684\u90A3\u9EBD\u597D\uFF01"
  - id: 9eb20c49e0b4491c8a90e4a2ddb1765d
    sprite: {fileID: 21300000, guid: 9e2c9d5b74f63464b9a6297a9b138259, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 1
    type: 0
    context:
      translations:
      - "There are plenty of people who can draw as well as I can."
      - "\u6BD4\u65B9\u8AAC\u50CF\u6211\u9019\u7A2E\u7A0B\u5EA6\u7684\u4EBA\u6EFF\u8857\u90FD\u662F"
  - id: e82b9a8cdbdd40628c6c5710f58ea408
    sprite: {fileID: 21300000, guid: 9e2c9d5b74f63464b9a6297a9b138259, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 1
    type: 0
    context:
      translations:
      - "And there are as many people who'll keep improving as there are stars in the sky."
      - "\u7136\u5F8C\u5728\u54EA\u88CF\u8CB7\u7684\u6703\u7E7C\u7E8C\u9032\u6B65\u7684\u4EBA\u4E5F\u591A\u5982\u5929\u4E0A\u7684\u7E41\u661F"
