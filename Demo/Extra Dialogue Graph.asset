  abstruct: 
  dialogueList:
  - id: 73c15fdbd29e43ebb12c7faad8269a84
    sprite: {fileID: 21300000, guid: a852d2b82156e814fb87401d161bacb1, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 0
    type: 1
    context:
      translations:
      - "Oh, this... There's a drawing inside..."
      - "\u554A \u9019\u500B \u88CF\u9762\u6709\u756B\u4E86\u4E9B\u4EC0\u9EBD..."
  - id: 0d9b4411cce74744a13906366785a142
    sprite: {fileID: 21300000, guid: 9e2c9d5b74f63464b9a6297a9b138259, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 1
    type: 0
    context:
      translations:
      - "Mm-hm."
      - "\u55EF"
  - id: 2dd5dd45f0b347f09f2c7803e00be39a
    sprite: {fileID: 21300000, guid: 9e2c9d5b74f63464b9a6297a9b138259, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 1
    type: 0
    context:
      translations:
      - "I was going to throw it away anyway, so it doesn't matter!"
      - "\u53CD\u6B63\u7B49\u6703\u4E5F\u6703\u6254\u6389\u7684\u6240\u4EE5\u90A3\u6A23\u5C31\u597D\u4E86!"
  - id: 666d0cf74ac94c8c993ba490db5d053a
    sprite: {fileID: 21300000, guid: a852d2b82156e814fb87401d161bacb1, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 0
    type: 1
    context:
      translations:
      - "Throw it away...? But it's a drawing."
      - "\u6254\u6389...\u9019\u662F\u756B\u554A"
  - id: a2f9428f92fd49129360a71cb56e11af
    sprite: {fileID: 21300000, guid: a852d2b82156e814fb87401d161bacb1, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 0
    type: 0
    context:
      translations:
      - "Did you draw this?"
      - "\u662F\u4F60\u756B\u7684\u5427?"
  - id: e7db8ef8678a482c897e2a585149a948
    sprite: {fileID: 21300000, guid: 9e2c9d5b74f63464b9a6297a9b138259, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 1
    type: 0
    context:
      translations:
      - "Yeah..."
      - "\u662F\u554A\u2014"
  - id: 923b638ba3a34aadaba0518bc634e12f
    sprite: {fileID: 21300000, guid: a852d2b82156e814fb87401d161bacb1, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 0
    type: 0
    context:
      translations:
      - "It's amazing... The way you've drawn this..."
      - "\u771F\u53B2\u5BB3...\u9019\u7A2E\u756B\u6CD5..."
  - id: 772c0819f5b64afe8bffafa102e74445
    sprite: {fileID: 21300000, guid: a852d2b82156e814fb87401d161bacb1, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 0
    type: 0
    context:
      translations:
      - "How do you even get colors like these...?"
      - "\u5230\u5E95\u600E\u6A23\u624D\u80FD\u756B\u51FA\u9019\u7A2E\u8272\u5F69\u5462..."
  - id: cc839140fa8045d394f0987c7bba9841
    sprite: {fileID: 21300000, guid: a852d2b82156e814fb87401d161bacb1, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 0
    type: 0
    context:
      translations:
      - "Throwing it away... What a waste!"
      - "\u6254\u6389\u4EC0\u9EBD\u7684...\u771F\u662F\u592A\u6D6A\u8CBB\u4E86\uFF01"
  - id: b663e6b052024d20b409426e4dceb63c
    sprite: {fileID: 21300000, guid: a852d2b82156e814fb87401d161bacb1, type: 3}
    spriteGuid: 
    spriteFileId: 0
    person: 0
    type: 2
    context:
      translations:
      - "I-if you don't want it, then give it to me!"
      - "\u4F60 \u4F60\u4E0D\u8981\u7684\u8A71\u5C31\u9001\u7D66\u6211\u5427!"
